# DecisionTrail Backend Configuration

# Database Configuration (PostgreSQL with pgvector, or fallback to sqlite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisiontrail
# Fallback example:
# DATABASE_URL=sqlite:///./decisiontrail.db

# AI Provider Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# GitHub API Configuration (Optional: increases rate limits from 60/hr to 5,000/hr)
# Create a Personal Access Token (classic or fine-grained) at https://github.com/settings/tokens
GITHUB_TOKEN=

# Indexing safety limits (a partial run resumes at the persisted next page)
INDEXING_MAX_PAGES=100
INDEXING_PAGE_SIZE=50

# App Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEBUG=True
