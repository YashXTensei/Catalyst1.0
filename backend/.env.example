# DecisionTrail Backend Configuration

# Database Configuration (PostgreSQL with pgvector, or fallback to sqlite)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/decisiontrail
# Fallback example:
# DATABASE_URL=sqlite:///./decisiontrail.db

# AI Provider Configuration
# Get your Gemini API key from https://aistudio.google.com/
# Primary API Key (Default & fallback for all subsystems)
GEMINI_API_KEY=

# Subsystem-Specific Gemini API Keys (Optional: Leave empty to use GEMINI_API_KEY)
# Useful to distribute RPM/RPD quotas across distinct API keys or Google Cloud projects:
# - EXTRACTION: Background decision extraction from discussions & PRs
# - EMBEDDING: Vector embeddings for decision indexing and semantic search
# - QA: Interactive chat synthesis and architectural Q&A
# - PR: Pull request drift & architectural sentinel analysis
GEMINI_API_KEY_EXTRACTION=
GEMINI_API_KEY_EMBEDDING=
GEMINI_API_KEY_QA=
GEMINI_API_KEY_PR=

GEMINI_MODEL=gemini-3.1-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# GitHub API Configuration (Optional: increases rate limits from 60/hr to 5,000/hr)
# Create a Personal Access Token (classic or fine-grained) at https://github.com/settings/tokens
GITHUB_TOKEN=

# App Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEBUG=True
